---
interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <nav aria-label="Primary navigation">
      <a href="/">Home</a>
      <a href="/about">About</a>
    </nav>
    <slot />
  </body>
</html>
