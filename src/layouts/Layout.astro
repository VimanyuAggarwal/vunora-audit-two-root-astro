---
import { fetchSiteCode } from '../lib/vunora'
const __vunoraSiteCode = await fetchSiteCode()
interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    {__vunoraSiteCode.head && (<div style="display:contents" data-vunora-site-code="head"><Fragment set:html={__vunoraSiteCode.head} /></div>)}
    <nav aria-label="Primary navigation">
      <a href="/">Home</a>
      <a href="/about">About</a>
    </nav>
    <slot />
    {__vunoraSiteCode.bodyEnd && (<div style="display:contents" data-vunora-site-code="body-end"><Fragment set:html={__vunoraSiteCode.bodyEnd} /></div>)}
  </body>
</html>
