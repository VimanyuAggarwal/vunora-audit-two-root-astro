---
import { fetchPage, useFields } from '../../lib/vunora'
  const { data: cmsPage } = await fetchPage('home', Astro.currentLocale, Astro.cookies.get('supercms_visitor_id')?.value)
  const f = useFields(cmsPage)
import Layout from '../../layouts/Layout.astro'

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'es' } }]
}
---

<Layout title={f.layout_title_1 ?? 'Prefixed home'}>
  <main>
    <h1>{f.heading_2 ?? 'Prefixed home'}</h1>
    <h2>{f.heading_3 ?? 'Served under a locale segment'}</h2>
    <p>{f.para_1 ?? 'This file answers the locale family and never the bare slash.'}</p>
  </main>
</Layout>
<script>
  // Vunora browser runtime
  import '../../lib/vunora'
</script>
